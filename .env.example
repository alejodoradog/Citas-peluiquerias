# Copia este archivo a .env.local y completa los valores. Nunca subas valores
# al repositorio: es público (docs/operacion/repo-publico.md).

# Supabase: en local salen de `pnpm supabase status` con Supabase local
# corriendo. En Vercel, Production apunta a barberias-prod y Preview a
# barberias-dev (docs/operacion/infraestructura-produccion.md, sección 5).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Turnstile (tarea 3.5). En local y en Preview, las llaves de prueba de
# Cloudflare; sin la del sitio, la app usa la del widget "Yapoin".
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Los secretos de las Edge Functions (NOTIFICATIONS_SECRET, RESEND_API_KEY,
# EMAIL_FROM, RESEND_WEBHOOK_SECRET, SITE_URL y PAYMENT_*) no van aquí: viven
# en los secretos de cada proyecto de Supabase (docs/operacion/configurar-resend.md).
